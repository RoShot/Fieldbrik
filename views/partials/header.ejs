<%#
  The banner band and the section strip, on every page.

  The 2009 shape: a deep blue band with the name at the left, the account at the
  right, and a darker strip beneath it carrying the section links, separated by
  pipes. Guests get the small login box the classic site had up in the band; it
  posts to /login, the same handler the log-in page uses, so it really signs you
  in rather than pretending to.

  The name is set in type. This site has no banner artwork and does not copy
  anybody else's, so the band carries the wordmark and the tagline only.
%>
<header class="fb-header fb-header--<%= authState %>">
  <div class="fb-container fb-header__row">
    <a class="fb-logo" href="/home">
      <span class="fb-logo__text"><%= site.name %></span>
      <span class="fb-logo__tag"><%= site.tagline[0] %> <%= site.tagline[1] %></span>
    </a>

    <% if (authState === 'guest') { %>
      <form class="fb-login" method="post" action="/login">
        <label class="fb-login__title" for="fb-login-name">Log In</label>
        <input id="fb-login-name" name="username" type="text" placeholder="Character Name" autocomplete="username" maxlength="20" required>
        <input name="password" type="password" placeholder="Password" autocomplete="current-password" required>
        <button class="fb-login__btn" type="submit">Log In</button>
      </form>
      <a class="fb-tab" href="/register">Sign Up</a>
    <% } else { %>
      <div class="fb-currency">
        <span class="fb-currency__row" title="<%= site.currency.premium %>">
          <%- include('currency-icon', { kind: 'bucks' }) %>
          <strong><%= viewer.currency.bucks.toLocaleString('en-US') %></strong> <%= site.currency.premium %>
        </span>
        <span class="fb-currency__row" title="<%= site.currency.earned %>">
          <%- include('currency-icon', { kind: 'tickets' }) %>
          <strong><%= viewer.currency.tickets.toLocaleString('en-US') %></strong> <%= site.currency.earned %>
        </span>
        <a class="fb-tab" href="/my-page"><%= viewer.username %></a>
        <a class="fb-tab" href="/settings">Settings</a>
      </div>
    <% } %>
  </div>
</header>

<nav class="fb-nav" aria-label="Site">
  <div class="fb-container fb-nav__inner">
    <% site.nav2009.forEach(function (link, index) { %>
      <% if (index > 0) { %><span class="fb-tab__sep" aria-hidden="true">|</span><% } %>
      <a class="fb-tab<%= (typeof currentPath !== 'undefined' && currentPath === link.href) ? ' is-active' : '' %>" href="<%= link.href %>"><%= link.label %></a>
    <% }); %>

    <form class="fb-navsearch" method="get" action="/home" role="search">
      <input name="q" type="search" placeholder="Search" aria-label="Search places">
      <button class="fb-btn" type="submit">Go</button>
    </form>
  </div>
</nav>
