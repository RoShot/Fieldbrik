<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= site.name %> - <%= site.tagline %>">
  <%# The ?v= is a cache buster: the stylesheet changes often during the build,
      and a stale copy shows the old avatar figure through the 3D canvas. %>
  <link rel="stylesheet" href="/css/fieldbrik.css?v=4">
  <%# Real artwork: banner, currency icons and badge images. %>
  <link rel="stylesheet" href="/css/art.css?v=1">
  <%# Extra stylesheet, used by the admin panel. Pages that do not pass it are
      unaffected; typeof keeps a missing local from throwing in EJS. %>
  <% if (typeof extraCss !== 'undefined' && extraCss) { %>
  <link rel="stylesheet" href="<%= extraCss %>">
  <% } %>
  <%# The 2009 skin, loaded last so it wins over the base and any page sheet.
      The admin panel keeps its own look, so it is skipped there. %>
  <% var isAdminPage = (typeof extraCss !== 'undefined' && extraCss && String(extraCss).indexOf('admin') !== -1); %>
  <% if (!isAdminPage) { %>
  <link rel="stylesheet" href="/css/legacy2009.css?v=1">
  <% } %>
</head>
<%# Pages that need a body class of their own pass one in; every other page
    keeps a bare body element. %>
<% if (typeof bodyClass !== 'undefined' && bodyClass) { %><body class="<%= bodyClass %>"><% } else { %><body><% } %>
