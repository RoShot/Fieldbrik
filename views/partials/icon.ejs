<%#
  A line icon, drawn inline as SVG.

  These are plain UI glyphs - a house, an envelope, a bag - not artwork of
  anybody's character or game, and they are drawn here rather than loaded as
  files because no icon set ships with the site. The colour comes from the text
  colour of whatever they sit in.
%>
<svg class="fb-ico" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<% if (name === 'home') { %>
  <path d="M2.5 7.2 8 2.8l5.5 4.4V13a.7.7 0 0 1-.7.7H3.2a.7.7 0 0 1-.7-.7z"></path>
  <path d="M6.3 13.7V9.5h3.4v4.2"></path>
<% } else if (name === 'person') { %>
  <circle cx="8" cy="5.3" r="2.6"></circle>
  <path d="M2.9 13.8c0-2.6 2.3-4.2 5.1-4.2s5.1 1.6 5.1 4.2"></path>
<% } else if (name === 'message') { %>
  <rect x="2" y="3.6" width="12" height="8.8" rx="1"></rect>
  <path d="m2.7 4.6 5.3 3.9 5.3-3.9"></path>
<% } else if (name === 'friends') { %>
  <circle cx="5.7" cy="5.7" r="2.2"></circle>
  <path d="M1.9 13.1c0-2.1 1.7-3.4 3.8-3.4s3.8 1.3 3.8 3.4"></path>
  <path d="M10.7 4.2a2.2 2.2 0 0 1 0 4.3M11.5 10c1.5.4 2.5 1.6 2.5 3.1"></path>
<% } else if (name === 'character') { %>
  <circle cx="8" cy="3.7" r="1.9"></circle>
  <path d="M8 5.6v4.1M8 6.7 5.5 8.5M8 6.7l2.5 1.8M8 9.7v3.5"></path>
<% } else if (name === 'bag') { %>
  <path d="M3 5.6h10l.8 8.4H2.2z"></path>
  <path d="M5.8 5.6V4a2.2 2.2 0 0 1 4.4 0v1.6"></path>
<% } else if (name === 'coin') { %>
  <circle cx="8" cy="8" r="5.6"></circle>
  <path d="M8 4.8v6.4M6.4 6.3h2.3a1.3 1.3 0 0 1 0 2.6H6.9a1.3 1.3 0 0 0 0 2.6h2.5"></path>
<% } else if (name === 'blog') { %>
  <path d="M2.4 3.5h11.2v6.6H8.2L5 12.6V10H2.4z"></path>
  <path d="M4.6 5.8h6.8M4.6 7.8h4.4"></path>
<% } else if (name === 'calendar') { %>
  <rect x="2.3" y="3.7" width="11.4" height="9.9" rx="1"></rect>
  <path d="M2.3 6.7h11.4M5.4 2.5v2.4M10.6 2.5v2.4"></path>
<% } else if (name === 'grid') { %>
  <rect x="2.4" y="2.4" width="4.6" height="4.6"></rect>
  <rect x="9" y="2.4" width="4.6" height="4.6"></rect>
  <rect x="2.4" y="9" width="4.6" height="4.6"></rect>
  <rect x="9" y="9" width="4.6" height="4.6"></rect>
<% } else if (name === 'star') { %>
  <path d="m8 2.4 1.7 3.5 3.8.5-2.8 2.7.7 3.8L8 11.1l-3.4 1.8.7-3.8L2.5 6.4l3.8-.5z"></path>
<% } else if (name === 'parents') { %>
  <circle cx="5.4" cy="4.8" r="2"></circle>
  <circle cx="10.7" cy="5.4" r="1.6"></circle>
  <path d="M1.7 13c0-2 1.7-3.2 3.7-3.2S9.1 11 9.1 13M9.5 13c0-1.6 1.2-2.6 2.7-2.6s2.6 1 2.6 2.6"></path>
<% } else if (name === 'help') { %>
  <circle cx="8" cy="8" r="5.7"></circle>
  <path d="M6.3 6.2a1.8 1.8 0 1 1 2.4 1.7c-.5.2-.7.6-.7 1.1v.4"></path>
  <circle cx="8" cy="11.6" r=".7" fill="currentColor" stroke="none"></circle>
<% } else if (name === 'gear') { %>
  <circle cx="8" cy="8" r="2.2"></circle>
  <path d="M8 1.8v1.7M8 12.5v1.7M1.8 8h1.7M12.5 8h1.7M3.6 3.6l1.2 1.2M11.2 11.2l1.2 1.2M12.4 3.6l-1.2 1.2M4.8 11.2l-1.2 1.2"></path>
<% } %>
</svg>
