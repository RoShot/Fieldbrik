<%#
  The bar across the top of the app layout.

  Blue, with the name in type at the left, the section links beside it, one wide
  search field, and the account cluster at the right: profile, messages, the two
  balances and settings. The name is set in type because no logo art exists for
  this site; the balances use the two currency pips, which are real artwork.
%>
<header class="fb-bar">
  <a class="fb-bar__brand" href="/home"><%= site.name.toUpperCase() %></a>

  <nav class="fb-bar__nav" aria-label="Site">
    <a class="fb-bar__link<%= currentPath === '/home' ? ' is-active' : '' %>" href="/home">Home</a>
    <a class="fb-bar__link<%= currentPath === '/catalog' ? ' is-active' : '' %>" href="/catalog">Catalog</a>
    <a class="fb-bar__link<%= currentPath === '/forum' ? ' is-active' : '' %>" href="/forum">Forum</a>
    <a class="fb-bar__link<%= currentPath === '/news' ? ' is-active' : '' %>" href="/news">News</a>
    <a class="fb-bar__link<%= currentPath === '/people' ? ' is-active' : '' %>" href="/people">People</a>
  </nav>

  <form class="fb-bar__search" method="get" action="/home" role="search">
    <input name="q" type="search" value="<%= typeof query !== 'undefined' ? query : '' %>" placeholder="Search" aria-label="Search places and creators">
    <button class="fb-bar__searchbtn" type="submit" aria-label="Search">
      <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="6.6" cy="6.6" r="4.6" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
        <line x1="10.2" y1="10.2" x2="14.6" y2="14.6" stroke="currentColor" stroke-width="1.7"></line>
      </svg>
    </button>
  </form>

  <div class="fb-bar__icons">
    <a class="fb-bar__icon" href="/my-page" title="My FieldBrik" aria-label="My FieldBrik"><%- include('icon', { name: 'person' }) %></a>
    <a class="fb-bar__icon" href="/messages" title="Messages" aria-label="Messages"><%- include('icon', { name: 'message' }) %></a>

    <% if (authState === 'member') { %>
      <span class="fb-bar__count" title="<%= site.currency.premium %>"><%- include('currency-icon', { kind: 'bucks' }) %><%= viewer.currency.bucks.toLocaleString('en-US') %></span>
      <span class="fb-bar__count" title="<%= site.currency.earned %>"><%- include('currency-icon', { kind: 'tickets' }) %><%= viewer.currency.tickets.toLocaleString('en-US') %></span>
      <a class="fb-bar__icon" href="/settings" title="Settings" aria-label="Settings"><%- include('icon', { name: 'gear' }) %></a>
    <% } else { %>
      <a class="fb-bar__login" href="/login">Log In</a>
      <a class="fb-bar__login" href="/register">Sign Up</a>
    <% } %>
  </div>
</header>
