<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <% if (notice) { %>
    <div class="fb-notice"><p><strong><%= notice %></strong></p></div>
  <% } %>

  <div class="fb-title-row">
    <h1 class="fb-title">Messages</h1>
    <span class="fb-pagecount"><%= unread %> unread</span>
  </div>

  <p class="fb-panel__more">
    <strong>Inbox</strong> &middot;
    <a href="/messages/sent">Sent (<%= sentCount %>)</a> &middot;
    <a href="/messages/compose">Write a message</a> &middot;
    <a href="/reports/mine">My Reports</a>
  </p>

  <table class="fb-table">
    <thead>
      <tr>
        <th scope="col">From</th>
        <th scope="col">Subject</th>
        <th scope="col">Received</th>
        <th scope="col">Delete</th>
      </tr>
    </thead>
    <tbody>
      <% if (messages.length === 0) { %>
        <tr>
          <td colspan="4" class="fb-table__last">No messages yet.</td>
        </tr>
      <% } %>
      <% messages.forEach(function (message) { %>
        <tr>
          <td><a class="fb-table__name" href="/people/<%= encodeURIComponent(message.from) %>"><%= message.from %></a></td>
          <td>
            <a href="/messages/<%= message.id %>"><%= message.subject %></a>
            <% if (!message.read) { %><span class="fb-msg--unread">new</span><% } %>
          </td>
          <td><%= message.date %></td>
          <td class="fb-table__last">
            <form method="post" action="/messages/<%= message.id %>/delete">
              <button class="fb-btn" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <p class="fb-pagination">Showing up to 100, newest first.</p>

  <section class="fb-panel">
    <h2 class="fb-panel__title">New Message</h2>
    <div class="fb-panel__body">
      <form class="fb-auth" method="post" action="/messages">
        <div class="fb-auth__row">
          <label for="msg-to">To</label>
          <input id="msg-to" name="to" type="text" placeholder="Username" maxlength="20" required>
        </div>
        <div class="fb-auth__row">
          <label for="msg-subject">Subject</label>
          <input id="msg-subject" name="subject" type="text" maxlength="120">
        </div>
        <div class="fb-auth__row fb-auth__row--top">
          <label for="msg-body">Message</label>
          <textarea id="msg-body" name="body" rows="5" maxlength="5000" required></textarea>
        </div>
        <div class="fb-auth__actions">
          <button class="fb-btn fb-btn--primary" type="submit">Send</button>
        </div>
      </form>
    </div>
  </section>

  <div class="fb-notice">
    <p><strong>Messages are private.</strong></p>
    <p>A message is addressed to one member and is shown to the two accounts in it. Deleting one
       removes your copy and leaves the other person's alone. Every message you receive can be
       reported from the message itself, and <a href="/reports/mine">My Reports</a> shows what
       happened to a report you filed.</p>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
