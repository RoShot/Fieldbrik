<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <div class="fb-title-row">
    <h1 class="fb-title">Inventory</h1>
    <span class="fb-pagecount"><%= owned.length %> <%= owned.length === 1 ? 'item' : 'items' %></span>
  </div>

  <section class="fb-panel">
    <h2 class="fb-panel__title">Currently wearing</h2>
    <div class="fb-panel__body">
      <% if (wearing.length === 0) { %>
        <p class="fb-muted">Nothing equipped.</p>
      <% } else { %>
        <ul class="fb-wearing">
          <% wearing.forEach(function (item) { %>
            <li class="fb-wearing__item">
              <span class="fb-wearing__thumb" style="--thumb: <%= item.thumb %>;" aria-hidden="true"></span>
              <span>
                <a href="/catalog/<%= item.id %>"><%= item.name %></a><br>
                <span class="fb-muted"><%= item.category %></span>
              </span>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </section>

  <section class="fb-panel">
    <h2 class="fb-panel__title"><%= viewerName %>'s Items</h2>
    <div class="fb-panel__body">
      <% if (owned.length === 0) { %>
        <p class="fb-muted">You do not own any items yet.</p>
      <% } else { %>
        <ul class="fb-grid--items">
          <% owned.forEach(function (item) { %>
            <li class="fb-card-item">
              <span class="fb-card-item__thumb" style="--thumb: <%= item.thumb %>;" aria-hidden="true"></span>
              <a class="fb-card-item__name" href="/catalog/<%= item.id %>"><%= item.name %></a>
              <p class="fb-card-item__meta">
                <%= item.category %><br>
                <% if (item.equipped) { %>
                  <strong>Wearing</strong>
                <% } else { %>
                  <span class="fb-muted">Not worn</span>
                <% } %>
              </p>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </section>

  <div class="fb-notice">
    <p><strong>Every item here belongs to the account.</strong></p>
    <p>Ownership and equipped status are real fixture data for <strong><%= viewerName %></strong>, and each item opens its catalog page. Wearing and removing items is disabled until the catalog and economy services exist in phases 2 and 3, so nothing on this page can change what your avatar is wearing.</p>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
