<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <p class="fb-crumbs"><a href="/home">Home</a> &raquo; <%= place.name %></p>

  <% if (notice) { %>
    <div class="fb-notice"><p><strong><%= notice %></strong></p></div>
  <% } %>

  <% if (!place.published) { %>
    <div class="fb-notice">
      <p><strong>This place is a draft.</strong></p>
      <p>Only you can see this page. Publish it from <a href="/places/<%= place.id %>/edit">Edit place</a>
         when it is ready, and it appears on the Home page for everybody.</p>
    </div>
  <% } %>

  <div class="fb-title-row">
    <h1 class="fb-title"><%= place.name %></h1>
    <span class="fb-pagecount"><%= place.published ? 'Published' : 'Draft' %></span>
  </div>

  <div class="fb-cols">
    <div class="fb-col-main">
      <span class="fb-hero" style="--thumb: <%= place.thumb %>;" aria-hidden="true"></span>

      <section class="fb-panel">
        <h2 class="fb-panel__title">About this place</h2>
        <div class="fb-panel__body fb-prose">
          <% if (place.description) { %>
            <%= place.description %>
          <% } else { %>
            <p class="fb-muted"><%= place.creator %> has not written a description yet.</p>
          <% } %>
        </div>
      </section>

      <section class="fb-panel">
        <h2 class="fb-panel__title">Details</h2>
        <div class="fb-panel__body fb-panel__body--flush">
          <table class="fb-table fb-table--kv">
            <tbody>
              <tr>
                <th scope="row">Creator</th>
                <td><a href="/people/<%= encodeURIComponent(place.creator) %>"><%= place.creator %></a></td>
              </tr>
              <tr>
                <th scope="row">Built</th>
                <td><%= place.created %></td>
              </tr>
              <tr>
                <th scope="row">Last updated</th>
                <td><%= place.updated %></td>
              </tr>
              <tr>
                <th scope="row">Visits</th>
                <td>Not counted yet</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <div class="fb-notice">
        <p><strong>There is no Play button on this page.</strong></p>
        <p>Playing a place needs the FieldBrik client, which is not built: there is no renderer and
           no session to join. Because nothing can be visited, no visit is recorded and the
           every-10-visits Ticket milestone stays unpaid. The listing above is real data about this
           place on its owner's account.</p>
      </div>
    </div>

    <aside class="fb-col-side">
      <div class="fb-creator">
        <% if (creator) { %>
          <%- include('../partials/avatar', { avatar: creator.avatar, size: 'md' }) %>
          <a class="fb-creator__name" href="/people/<%= encodeURIComponent(creator.username) %>"><%= creator.username %></a>
          <p class="fb-creator__meta"><%= creator.online ? 'Online now' : 'Offline' %></p>
        <% } else { %>
          <a class="fb-creator__name" href="/people/<%= encodeURIComponent(place.creator) %>"><%= place.creator %></a>
          <p class="fb-creator__meta">Creator</p>
        <% } %>
      </div>

      <% if (isOwner) { %>
        <section class="fb-panel">
          <h2 class="fb-panel__title">This is your place</h2>
          <div class="fb-panel__body">
            <p><a class="fb-btn" href="/places/<%= place.id %>/edit">Edit place</a></p>
            <form method="post" action="/places/<%= place.id %>/status">
              <input type="hidden" name="published" value="<%= place.published ? '0' : '1' %>">
              <button class="fb-btn<%= place.published ? '' : ' fb-btn--primary' %>" type="submit">
                <%= place.published ? 'Unpublish' : 'Publish' %>
              </button>
            </form>
            <p class="fb-admin__note">
              Unpublishing takes it off the Home page and keeps the page, your draft and its
              address. Nobody else can open an unpublished place.
            </p>
          </div>
        </section>
      <% } %>

      <section class="fb-panel">
        <h2 class="fb-panel__title">More places</h2>
        <div class="fb-panel__body">
          <p class="fb-muted"><a href="/home">Browse every place</a>, and filter by creator from the Home page.</p>
        </div>
      </section>
    </aside>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
