<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <div class="fb-title-row">
    <h1 class="fb-title">Games</h1>
    <span class="fb-pagecount"><%= places.length %> <%= places.length === 1 ? 'place' : 'places' %></span>
  </div>

  <div class="fb-cols">
    <aside class="fb-col-side">
      <h2 class="fb-facets__heading">Browse</h2>
      <ul class="fb-facets__list">
        <% browseFacets.forEach(function (facet) { %>
          <li class="<%= facet.active ? 'is-active' : '' %>"><a href="<%= facet.href %>"><%= facet.label %></a></li>
        <% }); %>
      </ul>

      <h2 class="fb-facets__heading">Creator</h2>
      <ul class="fb-facets__list">
        <% if (creatorFacets.length === 0) { %>
          <li class="fb-muted">Nobody has published a place yet.</li>
        <% } %>
        <% creatorFacets.forEach(function (facet) { %>
          <li class="<%= facet.active ? 'is-active' : '' %>"><a href="<%= facet.href %>"><%= facet.label %></a></li>
        <% }); %>
      </ul>

      <h2 class="fb-facets__heading">Your places</h2>
      <ul class="fb-facets__list">
        <% if (canCreate) { %>
          <li><a href="/places/mine">My Places</a></li>
          <li><a href="/places/new">Create a place</a></li>
        <% } else { %>
          <li><a href="/login">Sign in to build one</a></li>
        <% } %>
      </ul>
    </aside>

    <div class="fb-col-main">
      <form class="fb-toolbar" method="get" action="/games">
        <input type="search" name="q" value="<%= query %>" placeholder="Search places and creators">
        <button class="fb-btn" type="submit">Search</button>
        <% if (query) { %><a class="fb-muted" href="/games">Clear</a><% } %>
      </form>

      <% if (places.length === 0) { %>
        <div class="fb-notice">
          <p><strong>No places are published yet.</strong></p>
          <p>Every place here is made by a member, so this page is empty until somebody publishes
             one. <% if (canCreate) { %><a href="/places/new">Make the first one</a>.<% } else { %><a href="/login">Sign in</a> to make one.<% } %></p>
        </div>
      <% } else { %>
        <ul class="fb-grid--games">
          <% places.forEach(function (place) { %>
            <li>
              <a class="fb-card-game__thumb" href="/games/<%= place.slug %>" style="--thumb: <%= place.thumb %>;" aria-hidden="true" tabindex="-1"></a>
              <a class="fb-card-game__title" href="/games/<%= place.slug %>"><%= place.name %></a>
              <p class="fb-card-game__meta">
                By <a href="/people/<%= encodeURIComponent(place.creator) %>"><%= place.creator %></a><br>
                Built <%= place.created %>
              </p>
            </li>
          <% }); %>
        </ul>
        <p class="fb-pagination"><%= places.length %> <%= places.length === 1 ? 'place' : 'places' %></p>
      <% } %>

      <div class="fb-notice">
        <p><strong>No place can be played yet.</strong></p>
        <p>Building and playing happen in the FieldBrik client, which is a separate project and not
           built. A place is a real listing on a real account, with a real page: what it does not
           have yet is a world to walk into. Because nothing can be visited, visits are not counted,
           and the 500-Ticket milestone for every 10 visits has not paid anybody.</p>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
