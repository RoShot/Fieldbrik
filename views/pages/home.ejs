<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <div class="fb-cols">
    <aside class="fb-col-side">
      <section class="fb-panel">
        <h2 class="fb-panel__title">Member Login</h2>
        <div class="fb-panel__body fb-signin">
          <form method="get" action="/login">
            <label class="fb-muted" for="side-name">Character Name</label>
            <input id="side-name" name="username" type="text" autocomplete="username">
            <label class="fb-muted" for="side-pass">Password</label>
            <input id="side-pass" name="password" type="password" autocomplete="current-password">
            <button class="fb-btn" type="submit">Login</button>
          </form>
          <a class="fb-signin__forgot" href="/login">Forgot your password?</a>
        </div>
      </section>

      <section class="fb-panel">
        <h2 class="fb-panel__title">Platform</h2>
        <div class="fb-panel__body">
          <ul class="fb-statlines">
            <li>Members: <strong><%= stats.members.toLocaleString('en-US') %></strong></li>
            <li>Online now: <strong><%= stats.online.toLocaleString('en-US') %></strong></li>
            <li>Games: <strong><%= stats.games.toLocaleString('en-US') %></strong></li>
            <li>Catalog items: <strong><%= stats.itemsListed.toLocaleString('en-US') %></strong></li>
          </ul>
        </div>
      </section>

      <section class="fb-panel">
        <h2 class="fb-panel__title">Online Now</h2>
        <div class="fb-panel__body">
          <ul class="fb-onlinelist">
            <% online.forEach(function (user) { %>
              <li>
                <%- include('../partials/avatar', { avatar: user.avatar, size: 'xs' }) %>
                <a href="/people/<%= user.username %>"><%= user.username %></a>
              </li>
            <% }); %>
          </ul>
        </div>
      </section>
    </aside>

    <div class="fb-col-main">
      <h1 class="fb-title">FieldBrik Virtual Playworld</h1>
      <p class="fb-subtitle">FieldBrik is Free!</p>

      <div class="fb-prose">
        <h2>Build your own Place</h2>
        <p>Create buildings, castles, obstacle courses and traps with thousands of virtual bricks. Every place you build belongs to you, and can be shared with the whole community.</p>

        <h2>Meet new friends online</h2>
        <p>Visit a friend's place, talk about what you are building, and work on something together. Your friends list, profile and messages all live on your account.</p>

        <h2>Play in the Brick Arenas</h2>
        <p>Battle with the sword, railgun or rocket, or build battle tools. Be careful not to get "bricked". Games are made by members, for members.</p>
      </div>

      <div class="fb-notice">
        <p><strong>The FieldBrik client is in development.</strong></p>
        <p>Building and playing will happen in the FieldBrik client, which is a separate project and not part of this website. Until it exists, there is nothing to download and nothing to install. When it is ready, this page will say so.</p>
        <p><a href="/about">Read about the project</a> or <a href="/help">visit the Help centre</a>.</p>
      </div>

      <section class="fb-panel">
        <h2 class="fb-panel__title">Cool Places</h2>
        <div class="fb-panel__body">
          <ul class="fb-grid--games">
            <% featured.slice(0, 3).forEach(function (game) { %>
              <li>
                <a class="fb-card-game__thumb" href="/games/<%= game.id %>" style="--thumb: <%= game.thumb %>;" aria-hidden="true" tabindex="-1"></a>
                <a class="fb-card-game__title" href="/games/<%= game.id %>"><%= game.name %></a>
                <p class="fb-card-game__meta">
                  Creator: <%= game.creator %><br>
                  Played: <%= game.visits.toLocaleString('en-US') %> times<br>
                  <span class="fb-card-game__players"><%= game.players %> players online</span>
                </p>
              </li>
            <% }); %>
          </ul>
        </div>
      </section>

      <section class="fb-panel">
        <h2 class="fb-panel__title">Latest News</h2>
        <div class="fb-panel__body fb-prose">
          <% news.slice(0, 3).forEach(function (item) { %>
            <p>
              <strong><a href="/news"><%= item.title %></a></strong><br>
              <span class="fb-muted"><%= item.date %> - posted by <%= item.author %></span><br>
              <%= item.summary %>
            </p>
          <% }); %>
          <p class="fb-muted"><a href="/news">More news</a></p>
        </div>
      </section>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
