<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <div class="fb-title-row">
    <h1 class="fb-title">Forum</h1>
    <span class="fb-pagecount"><%= totalThreads %> threads</span>
  </div>

  <section class="fb-panel">
    <h2 class="fb-panel__title fb-panel__title--blue">Search the Forums</h2>
    <div class="fb-panel__body">
      <form class="fb-toolbar fb-forum__search" method="get" action="/forum">
        <input type="search" name="q" value="<%= query %>" placeholder="Search forum sections">
        <button class="fb-btn" type="submit">Search</button>
        <% if (query) { %><a class="fb-muted" href="/forum">Clear</a><% } %>
      </form>
    </div>
  </section>

  <table class="fb-table">
    <thead>
      <tr>
        <th scope="col">Forum</th>
        <th scope="col">Threads</th>
        <th scope="col">Posts</th>
        <th scope="col">Last Post</th>
      </tr>
    </thead>
    <tbody>
      <% sections.forEach(function (section) { %>
        <tr>
          <td>
            <a class="fb-table__name" href="/forum/<%= encodeURIComponent(section.slug) %>"><%= section.name %></a>
            <span class="fb-table__desc"><%= section.description %></span>
          </td>
          <td><%= section.threads %></td>
          <td><%= section.posts %></td>
          <td class="fb-table__last"><%= section.lastPost || 'No posts yet' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <% if (sections.length === 0) { %>
    <div class="fb-notice">
      <p><strong>No section matches that search.</strong></p>
      <p><a href="/forum">Show every section</a>.</p>
    </div>
  <% } %>

  <p class="fb-pagination">Page 1 of 1</p>

  <div class="fb-notice">
    <p><strong>Every section and thread here is real.</strong></p>
    <p>These sections, the threads in them and the replies are rows in the forum tables, and the
       counts above are counted from those rows rather than stored. Posting is open: sign in, open
       a section, then start a thread or reply to one that is not locked. A forum moderator can
       lock, pin or delete a thread, and each of those goes into the audit log.</p>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
