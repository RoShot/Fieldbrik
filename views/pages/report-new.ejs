<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <p class="fb-crumbs"><a href="/reports/mine">My Reports</a> &raquo; New report</p>

  <% if (failure) { %>
    <div class="fb-notice"><p><strong><%= failure %></strong></p></div>
  <% } %>

  <div class="fb-title-row">
    <h1 class="fb-title">Report <%= target.username %></h1>
  </div>

  <section class="fb-panel">
    <h2 class="fb-panel__title">What is being reported</h2>
    <div class="fb-panel__body">
      <table class="fb-table fb-table--kv">
        <tbody>
          <tr><th scope="row">Member</th><td><a href="/people/<%= encodeURIComponent(target.username) %>"><%= target.username %></a></td></tr>
          <tr><th scope="row">About</th><td><%= kindLabel %></td></tr>
          <% if (message) { %>
            <tr><th scope="row">Message</th><td>&ldquo;<%= message.subject %>&rdquo;</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <p class="fb-panel__strip">
      A report is read by FieldBrik staff. It is not shown to <%= target.username %>.
    </p>
  </section>

  <section class="fb-panel">
    <h2 class="fb-panel__title">Reason</h2>
    <div class="fb-panel__body">
      <form class="fb-form" method="post" action="/reports">
        <input type="hidden" name="kind" value="<%= kind %>">
        <input type="hidden" name="target_user_id" value="<%= target.id %>">
        <input type="hidden" name="target_username" value="<%= target.username %>">
        <% if (message) { %>
          <input type="hidden" name="message_id" value="<%= message.id %>">
        <% } %>

        <label for="fb-report-reason">Why are you reporting this?</label>
        <select id="fb-report-reason" name="reason" required>
          <% reasons.forEach(function (reason) { %>
            <option value="<%= reason.key %>"><%= reason.label %></option>
          <% }); %>
        </select>

        <label for="fb-report-detail">What happened? (optional, but it helps)</label>
        <textarea id="fb-report-detail" name="detail" rows="5" maxlength="2000"></textarea>

        <button class="fb-btn fb-btn--primary" type="submit">Send report</button>
      </form>
    </div>
  </section>

  <div class="fb-notice">
    <p><strong>One open report at a time.</strong></p>
    <p>While a report about this is open, a second one is refused. If the situation gets
       worse, reply to the message or <a href="/support">contact support</a> and say so.</p>
  </div>

  <p class="fb-panel__more"><a href="/reports/mine">My reports</a></p>
</main>

<%- include('../partials/footer') %>
</body>
</html>
