<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <p class="fb-crumbs"><a href="/people">People</a> &raquo; <%= person.username %></p>

  <% if (notice) { %>
    <div class="fb-notice">
      <p><strong><%= notice %></strong></p>
    </div>
  <% } %>

  <div class="fb-cols">

    <aside class="fb-col-profile">
      <div class="fb-profile">
        <%- include('../partials/avatar', { avatar: person.avatar, size: 'md' }) %>
        <h1 class="fb-profile__greeting"><%= person.username %></h1>
        <p class="fb-profile__sub">
          <%= person.online ? 'Online now' : 'Last online ' + person.lastOnline.slice(0, 10) %>
        </p>
        <p class="fb-profile__url"><%= site.domain %>/user/<%= person.id %></p>
        <div class="fb-profile__foot">
          <% if (friendAction === 'friends') { %>
            <form method="post" action="/friends/remove/<%= person.username %>">
              <button class="fb-btn" type="submit">Remove Friend</button>
            </form>
          <% } else if (friendAction === 'incoming') { %>
            <form method="post" action="/friends/accept/<%= person.username %>">
              <button class="fb-btn fb-btn--primary" type="submit">Accept Request</button>
            </form>
            <form method="post" action="/friends/decline/<%= person.username %>">
              <button class="fb-btn" type="submit">Decline</button>
            </form>
          <% } else if (friendAction === 'outgoing') { %>
            <form method="post" action="/friends/cancel/<%= person.username %>">
              <button class="fb-btn" type="submit">Cancel Request</button>
            </form>
          <% } else if (friendAction === 'blocked') { %>
            <span class="fb-muted">Blocked</span>
          <% } else if (friendAction === 'none') { %>
            <form method="post" action="/friends/request/<%= person.username %>">
              <button class="fb-btn fb-btn--primary" type="submit">Add Friend</button>
            </form>
          <% } %>
          <% if (friendAction !== 'signed-out' && friendAction !== 'blocked' && person.username !== viewer.username) { %>
            <a class="fb-btn" href="/messages/compose?to=<%= encodeURIComponent(person.username) %>">Send Message</a>
            <a href="/reports/new?kind=member&amp;user=<%= encodeURIComponent(person.username) %>">Report Abuse</a>
          <% } %>
        </div>
      </div>

      <section class="fb-panel">
        <h2 class="fb-panel__title">Badges</h2>
        <div class="fb-panel__body">
          <% if (heldBadges.length === 0) { %>
            <p class="fb-muted">No badges yet.</p>
          <% } else { %>
            <ul class="fb-grid--badges">
              <% heldBadges.forEach(function (badge) { %>
                <li class="fb-badge" title="<%= badge.description %>">
                  <% if (badge.art) { %>
                    <img class="fb-badge__art" src="<%= badge.art %>" alt="" width="34" height="34">
                  <% } else { %>
                    <span class="fb-badge__pip" style="--badge: <%= badge.color %>;" aria-hidden="true"></span>
                  <% } %>
                  <%= badge.name %>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </section>

      <section class="fb-panel">
        <h2 class="fb-panel__title">Statistics</h2>
        <div class="fb-panel__body">
          <ul class="fb-statlines">
            <li>Joined: <strong><%= person.joined %></strong></li>
            <li>Friends: <strong><%= person.stats.friends %></strong></li>
            <li>Badges: <strong><%= person.stats.badges %></strong></li>
            <li>Games created: <strong><%= person.stats.games %></strong></li>
            <li>Items owned: <strong><%= person.stats.items %></strong></li>
          </ul>
        </div>
      </section>
    </aside>

    <div class="fb-col-main">
      <section class="fb-panel">
        <h2 class="fb-panel__title">Showcase</h2>
        <div class="fb-panel__body fb-prose">
          <p><%= person.description %></p>
        </div>
        <p class="fb-panel__strip">Visited 0 times</p>
      </section>

      <section class="fb-panel">
        <h2 class="fb-panel__title">
          <span class="fb-panel__title-row">
            <span><%= person.username %>'s Friends</span>
            <span class="fb-muted"><%= person.stats.friends %> total</span>
          </span>
        </h2>
        <div class="fb-panel__body">
          <ul class="fb-grid--people">
            <% friends.forEach(function (friend) { %>
              <li class="fb-card-person">
                <%- include('../partials/avatar', { avatar: friend.avatar, size: 'sm' }) %>
                <a class="fb-card-person__name" href="/people/<%= friend.username %>"><%= friend.username %></a>
                <span class="fb-card-person__status"><%= friend.online ? 'Online' : 'Offline' %></span>
              </li>
            <% }); %>
          </ul>
        </div>
      </section>

      <section class="fb-panel">
        <h2 class="fb-panel__title"><%= person.username %>'s Places</h2>
        <div class="fb-panel__body">
          <% if (created.length === 0) { %>
            <p class="fb-muted">No published places yet.</p>
          <% } else { %>
            <ul class="fb-grid--games">
              <% created.forEach(function (place) { %>
                <li>
                  <a class="fb-card-game__thumb" href="/games/<%= place.slug %>" style="--thumb: <%= place.thumb %>;" aria-hidden="true" tabindex="-1"></a>
                  <a class="fb-card-game__title" href="/games/<%= place.slug %>"><%= place.name %></a>
                  <p class="fb-card-game__meta">
                    <% if (place.created) { %>Built <%= place.created %><% } else { %>By <%= person.username %><% } %>
                  </p>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </section>

      <div class="fb-notice">
        <p><strong>Everything on this page is real.</strong></p>
        <p>Badges, statistics and the friends listed here all come from the database, and those
           friends are that member's real accepted friendships, and each place listed above is one
           they published. Adding a friend sends a request
           that only becomes a friendship when the other person accepts, and Send Message writes
           a private message that lands in their inbox.</p>
        <p>There is a Report Abuse link on every profile and on every message you receive. A report
           goes into one moderation queue, is never shown to the member it is about, and is
           answered by a member of staff rather than by an automatic ban.</p>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
