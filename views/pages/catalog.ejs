<%- include('../partials/head', { pageTitle: pageTitle }) %>
<%- include('../partials/header') %>

<main class="fb-container fb-main">
  <div class="fb-title-row">
    <h1 class="fb-title">Catalog</h1>
    <span class="fb-pagecount"><%= items.length %> <%= items.length === 1 ? 'item' : 'items' %></span>
  </div>

  <% if (notice) { %>
    <div class="fb-notice"><p><strong><%= notice %></strong></p></div>
  <% } %>

  <div class="fb-cols">
    <aside class="fb-col-side">
      <h2 class="fb-facets__heading">Category</h2>
      <ul class="fb-facets__list">
        <% categoryFacets.forEach(function (facet) { %>
          <li class="<%= facet.active ? 'is-active' : '' %>"><a href="<%= facet.href %>"><%= facet.label %></a></li>
        <% }); %>
      </ul>

      <h2 class="fb-facets__heading">Price</h2>
      <ul class="fb-facets__list">
        <% priceFacets.forEach(function (facet) { %>
          <li class="<%= facet.active ? 'is-active' : '' %>"><a href="<%= facet.href %>"><%= facet.label %></a></li>
        <% }); %>
      </ul>

      <% if (creatorFacets.length > 0) { %>
        <h2 class="fb-facets__heading">Creator</h2>
        <ul class="fb-facets__list">
          <% creatorFacets.forEach(function (facet) { %>
            <li class="<%= facet.active ? 'is-active' : '' %>"><a href="<%= facet.href %>"><%= facet.label %></a></li>
          <% }); %>
        </ul>
      <% } %>
    </aside>

    <div class="fb-col-main">
      <form class="fb-toolbar" method="get" action="/catalog">
        <input type="search" name="q" value="<%= query %>" placeholder="Search the catalog">
        <button class="fb-btn" type="submit">Search</button>
        <% if (query) { %><a class="fb-muted" href="/catalog">Clear</a><% } %>
      </form>

      <% if (items.length === 0) { %>
        <div class="fb-notice">
          <p><strong>Nothing is on sale here yet.</strong></p>
          <p>Items come from creators' catalog rows. If a filter is on, <a href="/catalog">show every item</a> to start again.</p>
        </div>
      <% } else { %>
        <ul class="fb-grid--items">
          <% items.forEach(function (item) { %>
            <li class="fb-card-item">
              <span class="fb-card-item__thumb" style="--thumb: <%= item.thumb %>;" aria-hidden="true">
                <% if (item.image) { %><img src="<%= item.image %>" alt=""><% } %>
              </span>
              <a class="fb-card-item__name" href="/catalog/<%= item.id %>"><%= item.name %></a>
              <p class="fb-card-item__meta">
                <% if (item.tickets !== null) { %>
                  <span class="fb-price--tickets">Tx: <%= item.tickets %></span>
                <% } %>
                <% if (item.tickets !== null && item.bucks !== null) { %><br><% } %>
                <% if (item.bucks !== null) { %>
                  <span class="fb-price--bucks">R$: <%= item.bucks %></span>
                <% } %>
                <% if (item.tickets === null && item.bucks === null) { %>
                  <span class="fb-muted">Free</span>
                <% } %>
                <br>
                By <%= item.creator %>
                <% if (item.owned) { %><br><span class="fb-muted"><%= item.equipped ? 'Wearing' : 'Owned' %></span><% } %>
              </p>
            </li>
          <% }); %>
        </ul>
        <p class="fb-pagination">Page 1 of 1</p>
      <% } %>

      <div class="fb-notice">
        <p><strong>Prices are real. Buying spends real balances.</strong></p>
        <p>An item with both prices can be bought with either: the creator set a Tickets price and a Bucks price, and the rate between them is theirs to choose. Buying writes a ledger entry and adds the item to your inventory, and the balance on your account goes down by exactly the price shown here.</p>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
