<%- include('../partials/head', { pageTitle: pageTitle, extraCss: '/css/admin.css?v=1' }) %>
<link rel="stylesheet" href="/css/admin-mod.css">

<div class="fb-admin">
  <div class="fb-admin__bar">
    <div class="fb-admin__brand">
      <a class="fb-admin__logo" href="/admin">FieldBrik</a>
      <span class="fb-admin__logo-tag">Administration</span>
    </div>
    <div class="fb-admin__who">
      <strong><%= viewer.username %></strong> &middot; <%= admin.name %> (rank <%= admin.rank %>) &middot;
      <a href="/">Back to the site</a>
    </div>
    <%- include('status', { adminStatus: adminStatus }) %>
  </div>

  <div class="fb-admin__body">
    <%- include('sidebar', { adminNav: adminNav }) %>

    <main class="fb-admin__main">
      <% if (notice) { %>
        <div class="fb-notice fb-notice--admin"><p><strong><%= notice %></strong></p></div>
      <% } %>

      <div class="fb-panel">
        <h1 class="fb-panel__title fb-panel__title--blue">Currency: <%= account.username %></h1>
        <div class="fb-panel__body">
          <table class="fb-table fb-table--kv">
            <tbody>
              <tr><th scope="row">Account</th><td><strong><%= account.username %></strong> (ID <%= account.id %>)</td></tr>
              <tr><th scope="row">Role</th><td><%= account.roleName %> (rank <%= account.roleRank %>)</td></tr>
              <tr><th scope="row">Tickets</th><td><%= account.tickets %></td></tr>
              <tr><th scope="row">Bucks</th><td><%= account.bucks %></td></tr>
            </tbody>
          </table>

          <% if (canIssue) { %>
            <form method="post" action="/admin/users/<%= account.id %>/currency">
              <h2 class="fb-admin__heading">Adjust this account</h2>
              <p class="fb-admin__muted">
                Every change writes a ledger entry with the balance it left behind, and an
                audit entry naming you. Removing more than an account holds is refused rather
                than allowed to go negative.
              </p>

              <div class="fb-mod__field">
                <label for="fb-currency-direction">Direction</label>
                <select id="fb-currency-direction" name="action">
                  <option value="add">Add to the account</option>
                  <option value="take">Take from the account</option>
                </select>
              </div>

              <div class="fb-mod__field">
                <label for="fb-currency-kind">Currency</label>
                <select id="fb-currency-kind" name="currency">
                  <% currencies.forEach(function (name) { %>
                    <option value="<%= name %>"><%= name === 'bucks' ? 'Bucks' : 'Tickets' %></option>
                  <% }); %>
                </select>
              </div>

              <div class="fb-mod__field">
                <label for="fb-currency-amount">Amount (1 to <%= maxAmount %>)</label>
                <input id="fb-currency-amount" type="number" name="amount" min="1" max="<%= maxAmount %>" step="1" required>
              </div>

              <div class="fb-mod__field">
                <label for="fb-currency-reason">Reason (kept on the ledger and the audit log)</label>
                <input id="fb-currency-reason" type="text" name="reason" maxlength="200" required autocomplete="off">
              </div>

              <button class="fb-btn fb-btn--primary" type="submit">Record the change</button>
            </form>
          <% } else { %>
            <p>
              <strong>Your role cannot move currency on this account.</strong>
              Junior Administrator and above can issue, and never on themselves or on an
              account at or above their own rank. The balances and ledger below are readable.
            </p>
          <% } %>
        </div>
      </div>

      <div class="fb-panel">
        <h2 class="fb-panel__title">Recent ledger entries</h2>
        <div class="fb-panel__body fb-panel__body--flush">
          <table class="fb-table fb-table--admin">
            <thead>
              <tr>
                <th scope="col">When</th>
                <th scope="col">Currency</th>
                <th scope="col">Change</th>
                <th scope="col">Balance after</th>
                <th scope="col">Reason</th>
              </tr>
            </thead>
            <tbody>
              <% if (ledger.length === 0) { %>
                <tr><td colspan="5" class="fb-table__last">No currency has moved on this account yet.</td></tr>
              <% } %>
              <% ledger.forEach(function (entry) { %>
                <tr>
                  <td><%= entry.when %></td>
                  <td><%= entry.currency %></td>
                  <td><%= entry.delta > 0 ? '+' + entry.delta : entry.delta %></td>
                  <td><%= entry.balanceAfter %></td>
                  <td class="fb-table__note"><%= entry.reason %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <p class="fb-panel__more">
        <a href="/admin/users/<%= account.id %>">Back to <%= account.username %></a>
      </p>
    </main>
  </div>
</div>

</body>
</html>
