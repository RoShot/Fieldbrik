<%- include('../partials/head', { pageTitle: pageTitle, extraCss: '/css/admin.css?v=1' }) %>
<link rel="stylesheet" href="/css/admin-mod.css">

<div class="fb-admin">
  <div class="fb-admin__bar">
    <div class="fb-admin__brand">
      <a class="fb-admin__logo" href="/admin">FieldBrik</a>
      <span class="fb-admin__logo-tag">Administration</span>
    </div>
    <div class="fb-admin__who">
      <strong><%= viewer.username %></strong> &middot; <%= admin.name %> (rank <%= admin.rank %>) &middot;
      <a href="/">Back to the site</a>
    </div>
    <%- include('status', { adminStatus: adminStatus }) %>
  </div>

  <div class="fb-admin__body">
    <%- include('sidebar', { adminNav: adminNav }) %>

    <main class="fb-admin__main">
      <% if (notice) { %>
        <div class="fb-notice fb-notice--admin"><p><strong><%= notice %></strong></p></div>
      <% } %>

      <div class="fb-panel">
        <h1 class="fb-panel__title fb-panel__title--blue">News</h1>
        <div class="fb-panel__body fb-panel__body--flush">
          <table class="fb-table fb-table--admin">
            <thead>
              <tr>
                <th scope="col">Article</th>
                <th scope="col">Category</th>
                <th scope="col">Author</th>
                <th scope="col">Date</th>
                <th scope="col">Status</th>
                <th scope="col"></th>
              </tr>
            </thead>
            <tbody>
              <% if (articles.length === 0) { %>
                <tr><td colspan="6" class="fb-table__last">No articles yet. Write the first one below.</td></tr>
              <% } %>
              <% articles.forEach(function (article) { %>
                <tr>
                  <td>
                    <strong><%= article.title %></strong><br>
                    <span class="fb-muted"><%= article.published ? '/news/' + article.slug : 'not on the site' %></span>
                  </td>
                  <td><%= article.category %></td>
                  <td><%= article.author %></td>
                  <td><%= article.published ? article.date : '-' %></td>
                  <td><%= article.published ? 'published' : 'draft' %></td>
                  <td>
                    <a class="fb-btn" href="/admin/news/<%= article.id %>">Edit</a>
                    <form class="fb-inline" method="post" action="/admin/news/<%= article.id %>/status">
                      <input type="hidden" name="published" value="<%= article.published ? '0' : '1' %>">
                      <button class="fb-btn" type="submit"><%= article.published ? 'Unpublish' : 'Publish' %></button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

      <p><a class="fb-btn fb-btn--primary" href="/admin/news/new">Write an article</a></p>

      <p class="fb-admin__note">
        Publishing puts an article in the news list, in the category facets and in the home page's
        Latest News panel. Unpublishing it makes it a draft again: the article stays here, its URL
        stops resolving, and publishing it again puts it back. <%= drafts %> draft<%= drafts === 1 ? '' : 's' %> at the moment.
        Articles are never deleted, because a published URL may already be linked elsewhere.
      </p>
    </main>
  </div>
</div>

</body>
</html>
