// Generated by CMake from player/content/textures. Do not edit this copy; the
// files in that folder are what decide what is here.
//
// Every image in content/textures/bricks is compiled into the exe as a resource
// and listed here with the id it was given. The id starts at 201 and counts up
// in file-name order, so adding a texture renumbers the ones after it: nothing
// outside this header refers to those numbers.

#pragma once

namespace fieldbrik {

struct EmbeddedTexture {
  int id;
  const wchar_t* name;
};

// The first entry has no name and is skipped: it keeps the array valid when the
// folder is empty, which is how the client ships until the art arrives.
constexpr EmbeddedTexture kEmbeddedTextures[] = {
    {0, L""},
@TEXTURE_ENTRIES@};

// True when content/textures/sky holds a panorama, which is compiled in under
// Resources.h's sky id.
constexpr bool kSkyTexturePresent = @SKY_PRESENT@;

}  // namespace fieldbrik
