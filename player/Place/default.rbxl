<?xml version="1.0" encoding="utf-8"?>
<!--
  A FieldBrik place, in the XML format .rbxl used before it went binary.

  Everything is plain text: an Item per brick, and Properties inside it. What the
  client reads is Name, size/Size, CFrame, Color3uint8 or Color3, CanCollide and
  TextureID; anything else is ignored, so a map from elsewhere opens too.

  This file is the built-in test world written out, which makes it a starting
  point: copy it to place.rbxl beside FieldBrikPlayer.exe and edit it.

  A spawn point is an Item of class SpawnLocation. Only its CFrame and size are
  used — the player stands on its top surface. Uncomment the block at the end of
  Workspace to move the spawn to the red slab.
-->
<roblox version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="Workspace" referent="RBX0">
		<Properties>
			<string name="Name">Workspace</string>
		</Properties>
		<Item class="Part" referent="RBX1">
			<Properties>
				<string name="Name">Baseplate</string>
				<CoordinateFrame name="CFrame">
					<X>0</X>
					<Y>-0.5</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<Vector3 name="size">
					<X>80</X>
					<Y>1</Y>
					<Z>80</Z>
				</Vector3>
				<Color3uint8 name="Color3uint8">4287402380</Color3uint8>
				<bool name="Anchored">true</bool>
			</Properties>
		</Item>
